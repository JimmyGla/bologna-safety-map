{
  "name": "bologna-safety-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker": "tsx src/worker/index.ts",
    "db:up": "docker compose --env-file .env.local up -d",
    "db:down": "docker compose --env-file .env.local down",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "worker:once": "tsx src/worker/index.ts --once",
    "gazetteer:build": "tsx scripts/build-gazetteer.ts",
    "worker:dry": "tsx src/worker/index.ts --dry-run --once",
    "telegram:login": "tsx scripts/telegram-login.ts",
    "e2e:seed": "tsx scripts/e2e/seed.ts",
    "e2e:check": "tsx scripts/e2e/check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@atproto/api": "^0.29.1",
    "@google/genai": "^2.30.0",
    "@neondatabase/serverless": "^1.2.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "h3-js": "^4.5.0",
    "maplibre-gl": "^6.15.0",
    "next": "15.5.28",
    "node-cron": "^4.6.0",
    "node-html-parser": "^9.0.5",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "telegram": "^2.26.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
