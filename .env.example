# Copy to .env.local and fill in. Never commit .env.local.
# Zero-cost project: every value here is free (free tier or local). No paid APIs.
# Empty values count as unset.

# --- Database -------------------------------------------------------------
# Local dev: matches docker-compose.yml. Production: Neon free tier pooled
# connection string, e.g. postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/db?sslmode=require
POSTGRES_USER=bsm
POSTGRES_PASSWORD=bsm_dev_password
POSTGRES_DB=bologna_safety_map
POSTGRES_PORT=5432
DATABASE_URL=postgres://bsm:bsm_dev_password@localhost:5432/bologna_safety_map
# Neon only: the direct (non -pooler) URL, used by the worker and migrations.
DATABASE_URL_UNPOOLED=
# neon (HTTP, default on Vercel) | postgres (TCP pool, default elsewhere)
DB_DRIVER=
# Worker applies pending migrations from drizzle/ when it starts
MIGRATE_ON_START=true
# /api/cells requests per minute per client IP (in-memory, per instance)
CELLS_RATE_LIMIT_PER_MIN=60

# --- Privacy notice (/privacy) --------------------------------------------
# Shown as the data controller and contact. Set them in Vercel, then redeploy.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=

# --- Admin ------------------------------------------------------------------
# Password for /admin (at least 12 characters). Empty = admin disabled.
ADMIN_PASSWORD=
# Worker/server log level (pino): fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info

# --- LLM ------------------------------------------------------------------
# gemini | ollama | rules. Falls back to "rules" on quota exhaustion or errors.
LLM_PROVIDER=rules
# Google AI Studio free-tier key (https://aistudio.google.com). Never enable billing.
# Free-tier inputs may be used by Google to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# That model's free-tier limits (requests per minute / per day); check AI Studio
GEMINI_RPM=10
GEMINI_RPD=250
# Local Ollama (https://ollama.com), e.g. `ollama pull qwen2.5:7b`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Scoring --------------------------------------------------------------
# Score boundaries for levels 0|1|2|3 (anything higher is 4), see src/lib/scoring.ts
SCORE_THRESHOLDS=0.15,0.4,0.8,1.4

# --- Quota guard ----------------------------------------------------------
# Overrides of the free-tier defaults in src/lib/quota.ts: service=perMinute/perDay,...
# Check each provider's current free-tier limits before raising these.
QUOTA_LIMITS=
# Sent with every source request. Include a way to contact you.
SOURCE_USER_AGENT=bologna-safety-map/0.1 (contact: you@example.com)

# --- Sources --------------------------------------------------------------
# Local news RSS feeds, comma-separated. Empty = built-in list (Carlino Bologna,
# Repubblica Bologna cronaca, BolognaToday) in src/worker/sources/news.ts
SOURCE_NEWS_ENABLED=true
NEWS_RSS_URLS=

# TPER: public Telegram channel preview (live diversions) + Bologna news RSS
SOURCE_TPER_ENABLED=true
TPER_TELEGRAM_CHANNEL=TperInfoViabilita
TPER_RSS_URL=https://www.tper.it/taxonomy/term/33/all/rss.xml

# Bluesky search (free account + app password: Settings > Privacy and security > App passwords).
# Searches every "<keyword> <place>" pair plus each violence keyword with the first place,
# lang=it, newest first. Empty lists = defaults. The searches are rotated: each run does
# BLUESKY_QUERIES_PER_RUN of them (defaults: 22 searches, 8 per run = each every ~15 min
# with a 5-minute worker). The login session is reused between runs (stored encrypted).
SOURCE_BLUESKY_ENABLED=false
BSKY_HANDLE=
BSKY_APP_PASSWORD=
BLUESKY_KEYWORDS=corteo,manifestazione,scontri,presidio
BLUESKY_PLACES=bologna,zona universitaria,bolognina
BLUESKY_VIOLENCE_KEYWORDS=aggressione,aggredito,aggredita,pestaggio,accoltellato,rissa,squadristi,violenza sessuale,molestie,vandali
BLUESKY_QUERIES_PER_RUN=8

# Mastodon public hashtag timelines (no account). Always reads #bologna,
# #corteobologna, #manifestazionebologna; MASTODON_HASHTAGS adds more.
SOURCE_MASTODON_ENABLED=true
MASTODON_INSTANCES=https://mastodon.uno
MASTODON_HASHTAGS=

# Reddit public RSS
SOURCE_REDDIT_ENABLED=true
REDDIT_SUBREDDITS=bologna

# Telegram public channels (local news / official), read-only via a user session.
# Usernames without @, comma-separated. App credentials from https://my.telegram.org;
# TG_SESSION comes from `npm run telegram:login` and is as sensitive as a password.
# Suggested: comunebologna,bolognanotizie. comunebologna counts as an official source
# (OFFICIAL_TELEGRAM_CHANNELS in src/lib/scoring/credibility.ts); others count as social.
SOURCE_TELEGRAM_ENABLED=false
TELEGRAM_CHANNELS=
TG_API_ID=
TG_API_HASH=
TG_SESSION=
